rules_version = '2';

// Security rules for the Spelling Bee app.
//
// Admin status is the "admin" custom claim on the user's ID token
// (request.auth.token.admin). It is set server-side via scripts/set-admin.mjs
// and cannot be forged from the client — which is exactly why it is safe to
// grant admins wider access here.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Each child's saved progress/rewards live at users/{uid}.
    match /users/{uid} {
      // A user may read & write only their OWN document.
      // Admins (grown-ups) may read & write ANY user's document — e.g. to set a
      // child's daily goal.
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
