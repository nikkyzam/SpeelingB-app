{
  "name": "kids-spelling-bee",
  "version": "1.0.0",
  "description": "Faith-based educational spelling game for children",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "test:e2e": "start-server-and-test dev http://localhost:5173 cy:run",
    "test:visual": "vitest run __tests__/visual",
    "coverage": "vitest run --coverage",
    "lint": "eslint src --ext ts,tsx",
    "format": "prettier --write src/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:report": "cypress run --reporter mochawesome"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "confetti-js": "^0.0.18",
    "dayjs": "^1.11.9",
    "firebase": "^10.4.0",
    "framer-motion": "^12.0.0",
    "phaser": "^3.80.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "uuid": "^11.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.7",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-onboarding": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/cypress": "^10.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/axios": "^0.9.36",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^2.1.8",
    "cypress": "^13.17.0",
    "cypress-firebase": "^4.2.2",
    "cypress-mochawesome-reporter": "^4.0.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase-admin": "^13.6.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jsdom": "^25.0.1",
    "mocha": "^11.7.5",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.0",
    "mochawesome-report-generator": "^6.3.2",
    "msw": "^2.6.8",
    "nyc": "^17.1.0",
    "prettier": "^3.4.2",
    "start-server-and-test": "^2.1.3",
    "storybook": "^8.6.14",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}