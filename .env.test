# Placeholder Firebase config for the test run only (loaded by Vite in test mode).
#
# Not credentials: `getAuth()` throws on an empty/absent apiKey, which made every
# test that renders UserProvider fail to even collect. Tests never talk to
# Firebase — FirebaseSync and auth are mocked — they just need the SDK to
# initialise without exploding.
VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=test-project
VITE_FIREBASE_STORAGE_BUCKET=test-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
