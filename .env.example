# Copy to `.env` and fill in with your Firebase project's web-app config.
#
# These are REQUIRED to run the app: Firebase throws `auth/invalid-api-key` on
# start-up when the key is missing, React never mounts, and you get a blank
# white page with no error in the UI.
#
# Find them in the Firebase console → Project settings → Your apps → SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
